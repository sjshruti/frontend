<svg width="350" height="250" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg5" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FEF3C7;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#FDE68A;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="350" height="250" fill="url(#bg5)"/>
  <text x="175" y="110" font-family="Arial, sans-serif" font-size="24" font-weight="bold" text-anchor="middle" fill="#333">Snake Game</text>
  <text x="175" y="140" font-family="Arial, sans-serif" font-size="16" text-anchor="middle" fill="#666">JavaScript Game Development</text>
